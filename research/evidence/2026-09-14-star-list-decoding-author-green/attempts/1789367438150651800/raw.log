PvNP.RealizableHardness.StarListDecoding.exists_decoding.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2} [Fintype V]
  [Fintype E] {Sigma : V → Type u_3} [(v : V) → Fintype (Sigma v)] [∀ (v : V), Nonempty (Sigma v)] {m : ℕ} (p : E → ℝ)
  (hp : ∀ (e : E), 0 ≤ p e) (edges : E → Star V Sigma m) (A : (v : V) → Finset (Sigma v)) (rho : ℝ) (hrho : 0 < rho)
  (hbudget : listBudget p edges A ≤ rho) :
  ∃ l, ((eventMass p fun e => (edges e).listWitness A) - 1 / 8) / (8 * rho) ^ (m + 1) ≤ score p edges l
PvNP.RealizableHardness.StarListDecoding.selectedWeight_budget_iff.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2}
  [Fintype V] [Fintype E] {Sigma : V → Type u_3} [(v : V) → Fintype (Sigma v)] [∀ (v : V), Nonempty (Sigma v)] {m : ℕ}
  (p : E → ℝ) (hp : ∀ (e : E), 0 ≤ p e) (hnorm : ∑ e, p e = 1) (edges : E → Star V Sigma m)
  (A : (v : V) → Finset (Sigma v)) (rho : ℝ) :
  selectedWeight p edges A ≤ rho * (1 / alphabetMass p edges) ↔ listBudget p edges A ≤ rho
