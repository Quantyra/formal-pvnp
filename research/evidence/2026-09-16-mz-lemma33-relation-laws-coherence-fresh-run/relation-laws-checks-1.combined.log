PvNP.RealizableHardness.ActualStarSpanIntersection.row_private_outside_two_questions.{u_1, u_2} {X : Type u_1}
  {E : Type u_2} [Fintype X] [Fintype E] [DecidableEq X] [DecidableEq E] (row : E → Finset X)
  (hthree : ∀ (e : E), (row e).card = 3) (hlinear : ∀ (e f : E), e ≠ f → (row e ∩ row f).card ≤ 1) (U₁ U₂ U₃ : Finset E)
  (hU₁ : GoodQuestion row U₁) (hU₂ : GoodQuestion row U₂) (hU₃ : GoodQuestion row U₃) (e : E) (he₂ : e ∈ U₂)
  (he₁ : e ∉ U₁) (he₃ : e ∉ U₃) :
  ∃ x ∈ row e, x ∉ questionSupport row U₁ ∧ x ∉ questionSupport row U₃ ∧ x ∉ questionSupport row (U₂.erase e)
PvNP.RealizableHardness.ActualStarSpanIntersection.equationSpan_inf_sup_coordinateSpace_le.{u_1, u_2} {X : Type u_1}
  {E : Type u_2} [Fintype X] [Fintype E] [DecidableEq X] [DecidableEq E] (row : E → Finset X)
  (hthree : ∀ (e : E), (row e).card = 3) (hlinear : ∀ (e f : E), e ≠ f → (row e ∩ row f).card ≤ 1) (U₁ U₂ U₃ : Finset E)
  (hU₁ : GoodQuestion row U₁) (hU₂ : GoodQuestion row U₂) (hU₃ : GoodQuestion row U₃) :
  equationSpan row U₂ ⊓ (coordinateSpace row U₁ ⊔ coordinateSpace row U₃) ≤ equationSpan row U₁ ⊔ equationSpan row U₃
PvNP.RealizableHardness.ActualPresentedLeafGluing.actual_equationSpan_inf_sup_coordinateSpace_le {N m : ℕ}
  (I : Instance N m) (U₁ U₂ U₃ : Finset I.RowId) (hU₁ : GoodQuestion I.support U₁) (hU₂ : GoodQuestion I.support U₂)
  (hU₃ : GoodQuestion I.support U₃) :
  equationSpan I.support U₂ ⊓ (coordinateSpace I.support U₁ ⊔ coordinateSpace I.support U₃) ≤
    equationSpan I.support U₁ ⊔ equationSpan I.support U₃
