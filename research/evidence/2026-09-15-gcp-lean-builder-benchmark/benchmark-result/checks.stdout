PvNP.RealizableHardness.SubmoduleFunctionalGluing.existsUnique_glue_on_sup.{u_1, u_2, u_3} {K : Type u_1} {V : Type u_2}
  {W : Type u_3} [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W] (A B : Submodule K V)
  (f : ↥A →ₗ[K] W) (g : ↥B →ₗ[K] W) (hagree : ∀ (z : ↥(A ⊓ B)), f ⟨↑z, ⋯⟩ = g ⟨↑z, ⋯⟩) :
  ∃! F, F ∘ₗ Submodule.inclusion ⋯ = f ∧ F ∘ₗ Submodule.inclusion ⋯ = g
