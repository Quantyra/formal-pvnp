PvNP.RealizableHardness.ActualPresentedLeafGluing.starAccepts {N m J h : ℕ} {I : Instance N m} {n k : ℕ}
  (vs ws : Fin n → LeafVertex I J h) (hrel : ∀ (i : Fin n), (vs i).Rel (ws i))
